# Server
BLOG_ADDRESS=0.0.0.0
BLOG_PORT=5000

# Public URLs. ActivityPub identities and object ids are built from these values.
# TODO (domínio real): use the public HTTPS URL/domain, never localhost, in production.
# Com docker-compose, estes valores vêm daqui: backend/.env (produção) e backend/.env.dev (dev).
BASE_URL=http://localhost
BASE_URL_NAME=localhost
FRONTEND_URL=http://localhost

# ActivityPub tuning
AP_EXCERPT_LENGTH=600
AP_MAX_DELIVERY_ATTEMPTS=8
AP_WORKER_ENABLED=true

# Database
DATABASE_URL=postgres://local_user:local_pass@localhost/local_db
POSTGRES_USER=local_user
POSTGRES_PASSWORD=local_pass
POSTGRES_DB=local_db

# Auth/session
JWT_HASH="change-me"
ACTIX_COOKIE_KEY="change-me-to-a-long-random-value"
